# File này quyết định thứ KHÔNG được copy vào build context / image.
# Image chỉ cần: requirements.txt, app/, utils/

# Secret — lọt vào image là lộ khóa cho bất kỳ ai pull image
.env
.env.*
*.pem
*.key

# Git & môi trường ảo — nặng và vô dụng trong image
.git
.gitignore
.venv
venv/
env/

# Python cache
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache

# Không cần lúc chạy
tests/
screenshots/
nginx/
solution/
.github/
*.md
*.log
Dockerfile*
docker-compose*.yml
railway.toml
render.yaml
grade.py

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
